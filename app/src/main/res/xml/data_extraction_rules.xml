<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: progressi salvati nel backup cloud e copiati nel passaggio a un nuovo telefono. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="outflow_v4.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="outflow_v4.xml" />
    </device-transfer>
</data-extraction-rules>
